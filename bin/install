#!/bin/bash
# Install the launchd agent that runs bin/autocommit when references.bib changes.
set -euo pipefail
REPO=$(cd "$(dirname "$0")/.." && pwd)
LABEL=io.github.jovo.bib-autocommit
PLIST=~/Library/LaunchAgents/$LABEL.plist
LOG=~/Library/Logs/bib-autocommit.log
cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key><array><string>$REPO/bin/autocommit</string></array>
  <key>WatchPaths</key><array><string>$REPO/references.bib</string></array>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>$LOG</string>
  <key>StandardErrorPath</key><string>$LOG</string>
</dict>
</plist>
EOF
launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
launchctl bootstrap "gui/$(id -u)" "$PLIST"
echo "installed $LABEL, watching $REPO/references.bib, log at $LOG"
